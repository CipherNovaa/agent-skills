# Copy to .env (or export in your shell / systemd unit). Nothing here is secret;
# every value has a working default.

# Where the engines live (plugins and skills call them from here).
MYOS_ENGINES=~/agent-skills/engines

# Vault layout config (see config/paths.example.json).
MYOS_CONFIG=~/.config/myos/paths.json
# MYOS_VAULT=~/Documents/Obsidian Vault
# MYOS_ARCHITECT_MEMORY_DIR=~/path/to/your-agent/memory
# MYOS_SKILLS_DIR=~/agent-skills/skills/myos

# Janitor inputs.
# MYOS_EXPECTED_SKILLS=~/.config/myos/expected_skills.txt
# MYOS_CONTRACTS=~/.config/myos/contracts.json

# Local models (Ollama) and search.
# OLLAMA_HOST=http://localhost:11434
# MYOS_LLM_MODEL=qwen3:8b
# MYOS_EMBED_MODEL=all-minilm
# MYOS_SEARX_URL=http://localhost:8888/search
# MYOS_CACHE_DIR=~/.cache/myos

# Personalisation profiles (see config/learning_style.example.md).
# MYOS_LEARNING_STYLE=~/.hermes/learning_style.md
# MYOS_PLANNING_STYLE=~/.hermes/planning_style.md

# Where reminders are delivered (any `hermes cron --deliver` target).
# MYOS_REMINDER_DELIVER=discord
